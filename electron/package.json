{
  "name": "keszletfigyelo-desktop",
  "version": "1.0.0",
  "description": "Keszletkezelo alkalmazas kisebb kereskedeseknek",
  "author": "Keszletkezelo",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "hu.keszletfigyelo.app",
    "productName": "Keszletfigyelo",
    "files": [
      "main.js",
      "preload.js",
      "leveldb.js",
      "regiAdatok.js",
      "dist/**/*",
      "!dist/modul/**"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Keszletkezelo-Setup.exe",
      "shortcutName": "Készletkezelő",
      "uninstallDisplayName": "Készletkezelő"
    }
  }
}
