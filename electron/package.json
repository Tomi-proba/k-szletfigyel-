{
  "name": "keszletfigyelo-desktop",
  "version": "1.0.0",
  "description": "Keszletkezelo alkalmazas kisebb kereskedeseknek",
  "author": "Keszletfigyelo",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "hu.keszletfigyelo.app",
    "productName": "Keszletfigyelo",
    "files": ["main.js", "dist/**/*"],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Keszletfigyelo-Setup.exe"
    }
  }
}
